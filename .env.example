# Supabase connection (server-side only — never exposed to the browser).
# Copy to .env.local for local development, and set the same variables in
# the Vercel project (Settings → Environment Variables).

SUPABASE_URL=https://xxxx.supabase.co

# The organisation dashboard writes, creates accounts and reads auth users, so
# this must be the **service_role** key. It bypasses row-level security, which
# is safe only because every query runs server-side — see the note in
# src/lib/guards.ts about where authorisation is actually enforced.
SUPABASE_KEY=eyJ...

# Absolute base URL of the deployment. Used for the links inside the
# confirmation and password-reset e-mails, so it must be the domain users see —
# not a per-deployment Vercel hostname.
NEXT_PUBLIC_SITE_URL=https://one4five.tech

# Basemap tiles (optional — defaults to the R2 bucket baked into the code).
# NEXT_PUBLIC_PMTILES_URL=https://tiles.one4five.tech/europe-z13.pmtiles

# Basemap fonts + sprites. Default to Protomaps' own GitHub-hosted assets, which
# is fine to start but is someone else's GitHub Pages — for production, mirror
# them to our R2 (see CLAUDE.md) and point these at it. Not a licensing matter,
# a reliability one.
# NEXT_PUBLIC_GLYPHS_URL=https://tiles.one4five.tech/fonts/{fontstack}/{range}.pbf
# NEXT_PUBLIC_SPRITE_URL=https://tiles.one4five.tech/sprites/light

# Raster fallback tiles (only used by browsers without WebGL). Default is CARTO's
# public CDN, whose free basemaps carry usage limits a commercial product may
# exceed — repoint at our own raster tiles or a licensed provider if needed, and
# keep the attribution string in step with whatever is served.
# NEXT_PUBLIC_RASTER_TILES_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
# NEXT_PUBLIC_RASTER_ATTRIB=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>
