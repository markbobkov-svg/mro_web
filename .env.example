# Supabase connection (server-side only — never exposed to the browser).
# Copy to .env.local for local development, and set the same two variables in
# the Vercel project (Settings → Environment Variables).

SUPABASE_URL=https://xxxx.supabase.co

# Either the anon/publishable key or the service_role key works here. Reads
# only. Because every query runs server-side, the key never reaches the client.
SUPABASE_KEY=eyJ...
